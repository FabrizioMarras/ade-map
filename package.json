{
  "name": "ade-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:program": "node scripts/fetch-program.mjs",
    "data:pages": "node scripts/fetch-event-pages.mjs",
    "data:geocode": "node scripts/geocode.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:refresh": "npm run data:program && npm run data:pages && npm run data:geocode && npm run data:build",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "maplibre-gl": "^6.13.0"
  }
}
